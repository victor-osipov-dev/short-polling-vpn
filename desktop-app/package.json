{
  "name": "short-polling-vpn-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Short Polling VPN desktop client — subscription profiles, system proxy and TUN mode",
  "author": "FIMDI",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:127.0.0.1:5173 && electron . --dev\"",
    "build": "vite build",
    "start": "electron .",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.0",
    "electron": "^45.3.4",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.8",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "ru.fimdi.shortpollingvpn",
    "productName": "Short Polling VPN",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "..",
        "to": "core",
        "filter": ["*.py", "config.yaml"]
      },
      {
        "from": "backend",
        "to": "backend"
      },
      {
        "from": "resources/sing-box",
        "to": "sing-box"
      }
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "portable"
      ],
      "artifactName": "Short-Polling-VPN-${version}-portable.${ext}"
    }
  }
}
