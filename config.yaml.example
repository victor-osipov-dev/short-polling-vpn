# ============================================================
# vpn-poller config — скопируйте в config.yaml и настройте
# ============================================================
mode: client

# Для режима server: идентичность узла и пиры для relay-цепочек.
# node_id: "ru-1"
# relay_secret: "REPLACE_WITH_SHARED_RELAY_SECRET"
# peers:
#   de-1: "https://2.27.37.211:8443"

# Подписка: URL или локальный JSON. Если задана — user/узлы/профили
# и split-routing подтянутся с сервера.
# subscription:
#   url: "https://177.3.220.12:8443/sub/<token>"
#   file: ""

# Split-routing: классификация домен/IP и выбор маршрута.
# split_routing:
#   enabled: true
#   default: non_ru
#   actions:
#     ru: {route: "RU exit"}
#     non_ru: {route: "EU exits"}
#     private: {direct: true}
#   rules:
#     geoip: "https://177.3.220.12:8443/rules/geoip-ru.txt"
#     domains: "https://177.3.220.12:8443/rules/ru-domains.txt"

# Пользователь из подписки (для per-user auth). Если не задан — legacy PSK.
# user:
#   uuid: "7b1c2f1e-5a42-4c1e-9b2a-2f6d8c1e4a10"
#   secret: "base64url-32-bytes"
#   device_id: "9a2e6f10-3c44-4b9e-8e7d-1a2b3c4d5e6f"

client:
  socks5:
    bind_host: 127.0.0.1
    bind_port: 8888
  server_url: "https://YOUR_SERVER_IP:8443"
  poll_path: "/poll"          # путь VPN-ручки (можно сменить для маскировки)
  poll_interval_ms: 200
  poll_jitter_ms: 50
  poll_retry: 2                # повторы, если соединение не установилось (без дублей)
  poll_timeout_s: 8            # предел ожидания ответа на один полл
  pad_polls: true              # добивать пустые poll-запросы случайным padding
  max_chunk_bytes: 4096
  url_fail_limit: 3            # ошибок подряд до отправки URL в карантин
  url_cooldown_seconds: 60     # время карантина URL (секунды)
  disabled_urls: []            # URL, временно исключённые из ротации
  verify_tls: true
  poll_method: POST          # GET or POST
  poll_data_in: body         # body or header — куда класть d (зашифрованные данные)
  host_header: ""            # необязательно: кастомный Host-заголовок (CDN/vhost/DNS)
  idle_timeout:
    enabled: false           # true — прекращать поллинг при отсутствии трафика
    seconds: 300             # через сколько секунд бездействия останавливать поллинг
  dns_relay:
    enabled: false           # true — слушать локальный UDP для DNS и шлёть запросы через туннель
    bind_host: 127.0.0.1
    bind_port: 5353          # 5353 (без root); 53 — только с root/iptables-перехватом

server:
  bind_host: 0.0.0.0
  bind_port: 8443
  poll_path: "/poll"          # путь VPN-ручки (можно сменить для маскировки)
  max_chunk_bytes: 4096
  idle_timeout_seconds: 200
  dns_resolver: "8.8.8.8"    # куда сервер пересылает DNS-запросы (IP или hostname)
  dns_resolver_port: 53
  admin_service_url: "http://127.0.0.1:8444"  # необязательно: /sub/<token> проксируется в панель
  # Необязательно: выход через локальные SOCKS5-прокси по id последнего hop-а.
  # Нужно для маршрутов вида «Россия -> внешний VLESS-узел»: xray поднимает
  # локальный mixed-inbound в нужный outbound, сервер открывает соединения там.
  egress_proxies:
    xhttp-pl: "127.0.0.1:1101"   # id hop-а: адрес SOCKS5
  tls:
    cert: "/path/to/fullchain.pem"
    key: "/path/to/privkey.pem"

security:
  psk: "REPLACE_WITH_GENERATED_PSK"
  hmac_window_seconds: 30

# Пользователи из admin-панели (та же SQLite-БД и cluster-ключ).
# Если блок отсутствует — работает legacy-режим с общим PSK.
users:
  db_path: "/opt/short-polling-vpn/admin/data/vpn.db"
  cluster_key: "/opt/short-polling-vpn/admin/data/cluster.key"

logging:
  level: DEBUG
